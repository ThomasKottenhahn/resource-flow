convert 1 USD = 0.90 EUR;

def 1 bare_pcb [cost: 5.00 USD];
def 10 microchips [cost: 15.00 USD];

manual_solder [cost: 2.00 EUR, time: 45 min]: 
    1 bare_pcb, 10 microchips 
    -> 1 assembled_pcb;

smt_pick_and_place [cost: 12.00 EUR, time: 5 min]: 
    1 bare_pcb, 10 microchips 
    -> 1 assembled_pcb;

[cheapest] make 1 assembled_pcb;
