make_dough: 500 g flour *, 300 ml water *, 10 g yeast * -> 800 g pizza_dough;

buy_dough: 800 g pizza_dough * -> 800 g pizza_dough;

make_tomato_sauce: 300 g tomatoes *, 20 ml oil * -> 280 g pizza_sauce;

slice_cheese: 200 g cheese * -> 190 g grated_cheese;

assemble: 800 g pizza_dough, 280 g pizza_sauce, 190 g grated_cheese -> 1200 g pizza;

bake: 1200 g pizza -> 1150 g baked_pizza;

make 1150 g baked_pizza;