make_stock: 1000 ml water *, 200 g vegetables * -> 850 ml vegetable_stock *;

peel: 500 g potatoes * -> 450 g peeled_potatoes;

boil: 450 g peeled_potatoes, 500 ml vegetable_stock * -> 800 g boiled_potatoes;

fry: 500 g potatoes *, 50 ml oil * -> 450 g fried_potatoes;

mash: 800 g boiled_potatoes, 100 g butter * -> 850 g mashed_potatoes;

combine_a: 850 g mashed_potatoes, 450 g fried_potatoes -> 1200 g potato_dish;

combine_b: 850 g mashed_potatoes, 300 g vegetables * -> 1100 g potato_dish;

make 1200 g potato_dish;