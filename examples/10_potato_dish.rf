make_stock [time: 60 min]: 
    1000 ml water *, 200 g vegetables * [cost: 2.00] 
    -> 850 ml vegetable_stock *;

peel [time: 5 min]: 
    500 g potatoes * [cost: 1.00]
    -> 450 g potatoes [peeled];

boil [time: 20 min]: 
    450 g potatoes [peeled], 500 ml vegetable_stock * 
    -> 800 g potatoes [boiled];

fry [time: 15 min]: 
    500 g potatoes *, 50 ml oil * 
    -> 450 g potatoes [fried];

mash [time: 10 min]: 
    800 g potatoes [boiled], 100 g butter * 
    -> 850 g potatoes [mashed];

combine [time: 5 min]: 
    850 g potatoes [mashed], 450 g potatoes [fried] 
    -> 1200 g potato_dish;

combine [time: 5 min]: 
    850 g potatoes [mashed], 300 g vegetables * 
    -> 1100 g potato_dish;

make 1200 g potato_dish;