make_pasta_dough [time: 20 min]: 300 g flour * [cost: 1.19], 3 piece eggs * [cost: 0.90] -> 450 g pasta_dough;
roll_pasta [time: 10 min]: 450 g pasta_dough -> 400 g pasta_sheets *;

cut_onions [time: 5 min]: 50 g onions * [cost: 0.20] -> 50 g onions [cut];
cut_vegetables [time: 5 min]: 200g zucchini * [cost: 0.50], 200g eggplant * [cost: 0.40] -> 400g vegetables [cut];

make_tomato_sauce [time: 20 min]: 500 g tomatoes * [cost: 2.00], 50 g onions [cut] -> 450 g tomato_sauce;
make_sauce [time: 30 min]: 300g vegetables [cut], 450 g tomato_sauce -> 600 g sauce;

assemble [time: 15 min]: 400 g pasta_sheets, 600 g sauce, 100 g cheese * [cost: 2.00] -> 1000 g lasagna;

bake [time: 45 min]: 1000 g lasagna -> 900 g lasagna [baked];

make 900 g lasagna [baked];
make 200 g cheese;