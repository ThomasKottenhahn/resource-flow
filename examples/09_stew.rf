chop_vegetables [time: 15 min]: 
    500 g carrots * [cost: 2.15], 300 g potatoes * [cost: 1.55], 200 g onions * [cost: 1.29] 
    -> 950 g vegetables [chopped];

make_stock [time: 60 min]: 
    1000 ml water *, 100 g vegetables [chopped] 
    -> 900 ml vegetable_stock;

make_meat_base [time: 15 min]: 
    500 g meat * [cost: 10.00], 50 ml oil * [cost: 0.05] 
    -> 520 g fried_meat;

combine [time: 10 min]: 
    950 g chopped_vegetables, 520 g fried_meat, 900 ml vegetable_stock 
    -> 2200 g stew;

reduce [time: 30 min]: 
    2200 g stew 
    -> 1800 g stew [reduced];

make 1800 g stew [reduced];