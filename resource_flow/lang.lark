program: program_item*
    ?program_item: statement ";"
                 | query ";"
                 | def_stmt ";"
                 | let_stmt ";"
                 | convert_stmt ";"
                 | module

    def_stmt: "def" resource supplier_clause?
    let_stmt: "let" IDENTIFIER "=" multiset_expr

    module: "mod" IDENTIFIER tags? supplier_clause? "{" module_item* "}"

    ?module_item: statement ";"
                | let_stmt ";"
                | def_stmt ";"
                | convert_stmt ";"
                | module

    ?statement: transition
              | import_stmt

    import_stmt: "use" import_source ("::" import_path)?
    ?import_source: IDENTIFIER | ESCAPED_STRING | RELATIVE_PATH
    RELATIVE_PATH: ("." | "..") "/" /[a-zA-Z0-9_.\/-]+/
    ?import_path: IDENTIFIER | "{" IDENTIFIER ("," IDENTIFIER)* "}"

    transition: proc_header multiset_expr "->" multiset_expr tool_clause?

    proc_header: (label tags? | tags) ":"

    query: (label tags? | tags)? "make" multiset_expr using_clause?

    ?multiset_expr: multiset
                    | "(" multiset ")"

    multiset: multiset_item ("," multiset_item)*
    ?multiset_item: resource | IDENTIFIER -> macro_ref

    resource: NUMBER UNIT? name BASIC? tags?

    tool_clause: "with" tool ("," tool)*
    using_clause: "using" tool ("," tool)*
    supplier_clause: "at" IDENTIFIER
    tool: NUMBER? UNIT? name

    name: IDENTIFIER (" " IDENTIFIER)*

    label: IDENTIFIER

    tags: "[" tag ("," tag)* "]"

    ?tag: min_goal
        | max_goal
        | rel_goal
        | kv_tag
        | negated_tag
        | flag_tag

    min_goal: "min" IDENTIFIER
    max_goal: "max" IDENTIFIER
    rel_goal: IDENTIFIER REL_OP NUMBER unit_or_curr?

    negated_tag: "!" IDENTIFIER
    kv_tag: IDENTIFIER ":" NUMBER unit_or_curr?
    flag_tag: IDENTIFIER

    convert_stmt: "convert" NUMBER unit_or_curr "=" NUMBER unit_or_curr
    ?unit_or_curr: UNIT | IDENTIFIER | CURRENCY_SYM

    REL_OP: "<=" | "<" | ">=" | ">" | "==" | "!="

    BASIC: "*"
    UNIT: "mg" | "g" | "kg" | "ml" | "l" | "piece" | "min" | "s" | "h" | "kWh" | "kJ"
    CURRENCY_SYM: "€" | "$" | "£"
    
    IDENTIFIER: /[a-zA-Z][a-zA-Z0-9_]*/

    %import common.WS
    %import common.NUMBER
    %import common.ESCAPED_STRING
    %ignore WS
